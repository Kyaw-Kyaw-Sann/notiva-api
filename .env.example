# Copy this file to .env for local development. Do not commit .env.
# Deployment platforms should store these values as encrypted environment variables/secrets.

# PostgreSQL
DATABASE_URL=jdbc:postgresql://localhost:5432/notiva_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=
# JWT - use a long, cryptographically random Base64 secret (at least 256 bits).
JWT_SECRET=
JWT_ACCESS_EXPIRATION_MILLIS=900000
JWT_REFRESH_EXPIRATION_MILLIS=2592000000

# Public application URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8080
OAUTH2_FRONTEND_CALLBACK_URL=http://localhost:3000/oauth2/callback

# Email / SMTP
MAIL_USERNAME=
MAIL_APP_PASSWORD=
MAIL_FROM=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI providers
GROQ_API_KEY=
GROQ_MODEL=groq/compound-mini
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-4-lite

# Optional local logging and schema settings.
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false
JPA_DDL_AUTO=update

# Flyway is normally controlled by the active profile. Set this to true only
# for the one-time baseline of a verified, non-empty existing database.
FLYWAY_BASELINE_ON_MIGRATE=false
